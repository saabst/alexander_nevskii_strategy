# ─── зависимости ────────────────────────────────────────────────────
node_modules/

# ─── сборочные выходы: получаются командой, в репозитории не нужны ───
dist/
dist-offline/
*.tsbuildinfo
.vite/

# Папка release/ намеренно НЕ игнорируется: в ней лежит готовая игра,
# которую показывают двойным кликом. Обновляется командой  npm run release

# ─── Python: кеш и мусор ────────────────────────────────────────────
__pycache__/
*.py[cod]

# ─── редакторы и системы ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

